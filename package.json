{
  "name": "@devslab/vue-date-rail",
  "version": "0.2.0",
  "type": "module",
  "description": "Horizontal infinite-scroll date rail (day / month strip) picker for Vue 3",
  "main": "./dist/vue-date-rail.cjs.js",
  "module": "./dist/vue-date-rail.es.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/vue-date-rail.es.js",
      "require": "./dist/vue-date-rail.cjs.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "build:types": "vue-tsc --declaration --emitDeclarationOnly --outDir dist/types",
    "build:demo": "vite build --config demo/vite.config.ts",
    "check:brand": "node scripts/check-brand-assets.mjs",
    "verify": "npm run check:publisher && npm run check:brand && npm run test:run && npm run build && npm run build:types && npm run build:demo",
    "dev:demo": "vite --config demo/vite.config.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "prepublishOnly": "npm run verify",
    "build:publisher": "node scripts/build-publisher.mjs",
    "check:publisher": "node scripts/build-publisher.mjs --check"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@devslab/site-kit": "0.8.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "fast-check": "^4.1.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "vue",
    "vue3",
    "date-picker",
    "date-rail",
    "horizontal-datepicker",
    "date-strip",
    "infinite-scroll",
    "month-picker",
    "calendar-strip",
    "mobile",
    "i18n"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/devslab-kr/vue-date-rail.git"
  },
  "homepage": "https://devslab-kr.github.io/vue-date-rail",
  "bugs": {
    "url": "https://github.com/devslab-kr/vue-date-rail/issues"
  }
}
